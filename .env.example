# Replicate API token (Required for GFPGAN image restoration)
# Get your token at https://replicate.com/account/api-tokens
REPLICATE_API_KEY=

# Bytescale / Upload.io Public API Key (Optional: defaults to "free" tier if not set)
# Get your key at https://www.bytescale.com
NEXT_PUBLIC_UPLOAD_API_KEY=

# Upstash Redis (Optional: only needed if you want rate limiting)
# Get your credentials at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
